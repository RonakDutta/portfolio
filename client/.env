# Where the site is actually served from. Substituted into index.html at build
# time for the canonical link, the Open Graph tags and the JSON-LD, all three of
# which need an absolute origin and none of which can work it out at runtime.
#
# Set this to your real domain before deploying. A canonical pointing at the
# wrong host is worse than none at all: it tells search engines the page they
# just crawled lives somewhere else.
#
# No trailing slash.
VITE_SITE_URL=https://ronakdutta.vercel.app
